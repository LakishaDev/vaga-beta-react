{
  "name": "vaga-beta-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "node server.js",
    "build": "npm run generate:sitemap && vite build",
    "build:ssr": "npm run generate:sitemap && vite build -c vite.config.ssr.js",
    "build:hybrid": "npm run generate:sitemap && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "cross-env SSR_BUILD=true vite build --ssr src/entry-server-cloudflare.jsx --outDir dist/server",
    "build:cloudflare": "npm run build:hybrid",
    "preview:hybrid": "npx wrangler pages dev dist --compatibility-date=2024-01-01",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "analyze": "vite build --mode analyze",
    "build:prod": "npm run lint && npm run generate:sitemap && vite build",
    "serve": "vite preview --port 4173",
    "serve:ssr": "NODE_ENV=production node server.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "compression": "^1.8.1",
    "express": "^4.22.1",
    "firebase": "^12.3.0",
    "firebase-admin": "^13.0.0",
    "framer-motion": "^12.23.22",
    "lenis": "^1.3.11",
    "lucide-react": "^0.544.0",
    "motion": "^12.24.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-firebase-hooks": "^5.1.1",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.3",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "baseline-browser-mapping": "^2.9.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "terser": "^5.36.0",
    "vite": "^7.1.7",
    "wrangler": "^4.59.3"
  }
}
