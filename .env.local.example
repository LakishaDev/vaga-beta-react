# .env.local.example - Kopiraj u .env.local i dodaj prave vrednosti
# NIKAD ne commit-uj .env.local fajl!

########################### Firebase konfiguracija ###########################

## API ključ projekta - dobij iz Firebase Console ##
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

## Domen za autentifikaciju ##
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

## ID projekta ##
VITE_FIREBASE_PROJECT_ID=your_project_id

## Storage Bucket ##
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

## Sender ID za Cloud Messaging ##
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

## App ID ##
VITE_FIREBASE_APP_ID=your_app_id

## Measurement ID - optional ##
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

## Firebase App Check Debug Token - samo za development ##
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=your_debug_token

## reCAPTCHA v3 site key ##
VITE_FIREBASE_RECAPTCHA_SITE_KEY=your_recaptcha_key

########################### Cloudflare Configuration ###########################

## Cloudflare Account ID - tajno, nikada ne deliti! ##
VITE_CLOUDFLARE_ACCOUNT_ID=your_account_id

## Cloudflare API Token - tajno, nikada ne deliti! ##
VITE_CLOUDFLARE_API_TOKEN=your_api_token

########################### Admin Configuration ###########################

## Comma-separated lista admin emailova ##
VITE_ADMIN_EMAILS=admin@example.com,admin2@example.com
