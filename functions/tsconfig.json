{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "outDir": "lib",
    "rootDir": "src",

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"],
    "lib": ["ES2020"],

    "esModuleInterop": true
  },
  "include": ["src", "setAdmin.js"],
  "exclude": ["node_modules", "../node_modules", "lib"]
}
