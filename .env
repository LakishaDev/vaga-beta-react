# Cloudflare R2 Configuration - PUBLIC VALUES ONLY
# Tajni API token i Account ID moraju biti samo u .env.local
VITE_R2_WORKER_URL=https://worker.vagabeta.rs
VITE_R2_BUCKET_NAME=vaga-beta-cache
VITE_R2_BUCKET_REGION=auto

# Development
VITE_R2_WORKER_URL_DEV=https://worker.vagabeta.rs

# NOTE: NIKAD ne dodaj ove vrednosti ovde:
# - VITE_CLOUDFLARE_ACCOUNT_ID
# - VITE_CLOUDFLARE_API_TOKEN
# - Firebase keys
# - reCAPTCHA keys
# Koristi .env.local za tajne vrednosti!
