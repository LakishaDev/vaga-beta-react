# wrangler.toml - Cloudflare Pages Configuration
# Verzija: 3.0.0 - Pages-compatible
# For GitHub integration deployment to Cloudflare Pages
# Build settings should be configured in Cloudflare Pages Dashboard
# ili kroz [vars] blok ispod (ako je env management zaključan na wrangler.toml)

name = "vaga-beta"
pages_build_output_dir = "dist"
compatibility_date = "2024-01-01"

[vars]
VITE_FIREBASE_API_KEY = "REPLACE_ME"
VITE_FIREBASE_AUTH_DOMAIN = "REPLACE_ME"
VITE_FIREBASE_PROJECT_ID = "REPLACE_ME"
VITE_FIREBASE_STORAGE_BUCKET = "REPLACE_ME"
VITE_FIREBASE_MESSAGING_SENDER_ID = "REPLACE_ME"
VITE_FIREBASE_APP_ID = "REPLACE_ME"
VITE_FIREBASE_MEASUREMENT_ID = "REPLACE_ME"
VITE_FIREBASE_RECAPTCHA_SITE_KEY = "REPLACE_ME"
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN = "REPLACE_ME"
VITE_ADMIN_EMAILS = "admin@example.com"

# Note: Build command and environment variables should be set in
# Cloudflare Pages Dashboard under Settings > Builds & deployments
# Build command: npm run build:prod
# Build output directory: dist
# Node version: 18 or higher
CACHE_TTL = "31536000"
VIDEO_TTL = "86400"

# Triggers (ako koristiš Cron)
[triggers]
crons = ["0 0 * * *"]

# Logger configuration
[observability]
enabled = true

# Telemetry
[[telemetry]]
enabled = true
