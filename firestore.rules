rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  	/* ============================
       HELPERS
    ============================ */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
	      (exists(/databases/$(database)/documents/nalozi/$(request.auth.uid)) &&
	      get(/databases/$(database)/documents/nalozi/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function hasReservedSlug(slug) {
      return slug.matches('^(admin|api|kontakt|usluge|newsletter|privacy|prodavnica|proizvod|proizvodi|search|booking|onama|aplikacija|evaga-desktop|p)$');
    }

    function hasValidSlug(slug) {
      return slug is string &&
             slug.size() >= 3 &&
             slug.size() <= 120 &&
             slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') &&
             !hasReservedSlug(slug);
    }

    function hasValidProductPayload(data) {
      return hasValidSlug(data.slug);
    }
    
    /* ============================
       LICENSES
       - Samo admin može da čita
       - NEMA write iz frontenda
    ============================ */
    match /licenses/{licenseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* ============================
       ACTIVATIONS
       - Samo admin vidi aktivacije
       - Desktop NEMA pristup
    ============================ */
    match /activations/{activationId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    /* ============================
       SUBSCRIPTIONS / AUTO RENEW
    ============================ */
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin()
                  || (isSignedIn() && request.auth.uid == resource.data.userId);

      allow write: if false;
    }
    
    /* ============================
       ANALYTICS (AGGREGATES)
       - Samo admin
    ============================ */
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // nalozi - svaki korisnik čita i piše svoj nalog
    match /nalozi/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // orders - korisnik vidi svoje narudžbine, admin vidi sve
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    // products - svi mogu da čitaju, admin može da piše
    match /products/{productId} {
      allow read: if true;

      // create: admin + validan slug
      allow create: if isAdmin() && hasValidProductPayload(request.resource.data);

      // update: admin + validan slug + slug immutable
      allow update: if isAdmin() &&
                      hasValidProductPayload(request.resource.data) &&
                      request.resource.data.slug == resource.data.slug;

      // delete: admin
      allow delete: if isAdmin();
    }

    // productSlugs index - jedinstvenost slug-a
    match /productSlugs/{slug} {
      allow read: if true;

      allow create: if isAdmin() &&
                      hasValidSlug(slug) &&
                      request.resource.data.slug == slug &&
                      request.resource.data.productId is string &&
                      !exists(/databases/$(database)/documents/productSlugs/$(slug));

      allow update: if isAdmin() &&
                      request.resource.data.slug == resource.data.slug &&
                      request.resource.data.productId == resource.data.productId;

      allow delete: if isAdmin();
    }
    // reviews - samo ulogovani pišu, svi čitaju
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // bookings - korisnik pravi i čita svoje zahteve, admin upravlja svime
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);

      allow create: if isSignedIn() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.userName is string &&
                    request.resource.data.userEmail is string &&
                    request.resource.data.userPhone is string &&
                    request.resource.data.service is string &&
                    request.resource.data.serviceDetails is string &&
                    request.resource.data.scaleType is string &&
                    request.resource.data.scaleModel is string &&
                    request.resource.data.scaleSerialNumber is string &&
                    request.resource.data.location is string &&
                    request.resource.data.deliveryRequired is bool &&
                    request.resource.data.notes is string;

      allow update, delete: if isAdmin();
    }

    match /korpa/{userUID} {
      allow read, write: if request.auth != null && request.auth.uid == userUID;
    }
    
    /* ============================
       USERS - eVagaClientMobile korisnici
       - Admin vidi sve
       - Korisnik vidi samo svoj profil
       - Cloud Functions kreiraju/brišu
    ============================ */
    match /users/{userId} {
      // Read: Admin vidi sve, korisnik samo svoj profil
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      
      // Write: NEMA iz frontenda - samo Cloud Functions
      allow write: if false;
    }

    // promotions - svi mogu da citaju, admin menja konfiguraciju promocije
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // fallback za sve ostalo - zabrani
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
