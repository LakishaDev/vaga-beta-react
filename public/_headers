# _headers fajl za Cloudflare Pages deployment
# Bezbedni security headers + Performance optimizacije

/*
  # Security Headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  
  # Permissions Policy - Ograniči pristup osetljivim API-ima
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  
  # CORS - Dozvoli sve izvore za CDN, ali ograniči metode
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Accept
  Access-Control-Max-Age: 86400
  
  # Content Security Policy - JAKO VAŽNO!
  # Dozvoli samo bezbedne izvore za skripte, stilove, slike
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com https://*.firebaseapp.com https://*.firebase.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: http:; connect-src 'self' https://*.firebaseapp.com https://*.firebase.com https://*.googleapis.com https://*.google-analytics.com https://*.vagabeta.rs wss://*.firebaseio.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;

# Cache control za statičke resurse - optimizovano za Cloudflare
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/imgs/*
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000

/*.js
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000

/*.css
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000

# Ne keširaj HTML fajlove - kontroliši sa strane servera
/*.html
  Cache-Control: public, max-age=0, must-revalidate, no-cache, no-store
  X-Content-Type-Options: nosniff

# Manifest i service worker
/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/manifest+json

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

# Firebase konfiguracija
/firebase.json
  Cache-Control: public, max-age=3600, must-revalidate

# Sitemap i robots
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain

# API rute
/api/*
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# R2 proxy rute (ako koriste)
/r2/*
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000

## Video fajlovi
/videos/*
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000
  Content-Type: video/mp4
