# _headers fajl za Cloudflare Pages deployment
# Bezbedni security headers + Performance optimizacije

/*
  # ===== PERMISIVNI SECURITY HEADERS =====
  
  # Frame embedding - dozvoli više sources
  X-Frame-Options: ALLOW-FROM *
  
  # Content Type
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  
  # Referrer Policy - fleksibilna
  Referrer-Policy: no-referrer-when-downgrade
  
  # HSTS - omekšana
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  
  # === PERMISIVNI CORS - Dozvoli sve ===
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, POST, PUT, DELETE, PATCH, OPTIONS
  Access-Control-Allow-Headers: *
  Access-Control-Allow-Credentials: true
  Access-Control-Max-Age: 86400
  Access-Control-Expose-Headers: *
  
  # === PERMISIVNA CSP - Praktično bez ograničenja ===
  Content-Security-Policy: default-src *; script-src * 'unsafe-inline' 'unsafe-eval' data:; style-src * 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:; font-src * data:; connect-src * data: blob: ws: wss:; frame-src *; object-src *; base-uri *; form-action *; frame-ancestors *;
  
  # Permissions Policy - omogući sve
  Permissions-Policy: geolocation=*, microphone=*, camera=*, payment=*, usb=*, magnetometer=*, gyroscope=*, accelerometer=*, vr=(), xr-spatial-tracking=*

# Cache control za statičke resurse - optimizovano za Cloudflare
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/imgs/*
  Cache-Control: public, max-age=3600, must-revalidate, s-maxage=3600

/*.js
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000

/*.css
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000

# Ne keširaj HTML fajlove - kontroliši sa strane servera
/*.html
  Cache-Control: public, max-age=0, must-revalidate, no-cache, no-store
  X-Content-Type-Options: nosniff

# Manifest i service worker
/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/manifest+json

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate

# Firebase konfiguracija
/firebase.json
  Cache-Control: public, max-age=3600, must-revalidate

# Sitemap i robots
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/xml

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: text/plain

# API rute
/api/*
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# R2 proxy rute (ako koriste)
/r2/*
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000

## Video fajlovi
/videos/*
  Cache-Control: public, max-age=31536000, immutable, s-maxage=31536000
  Content-Type: video/mp4
